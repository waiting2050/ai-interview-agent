HTTP_ADDR=:8080
DATABASE_URL=postgres://interview:interview@localhost:5433/interview?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
RUN_STALE_AFTER=60s

# 会话锁：TTL 限制崩溃实例占用锁的时长；抢锁等待超时后返回可重试的 409。
LOCK_TTL=10s
LOCK_ACQUIRE_TIMEOUT=3s

# 模型 provider：heuristic（默认，无需 key）或 openai（任意 OpenAI 兼容服务）
# 留空时：有 OPENAI_API_KEY 则选 openai，否则 heuristic
MODEL_PROVIDER=heuristic
# 默认按 DeepSeek 的 OpenAI 兼容端点配置：
#   DeepSeek：https://api.deepseek.com/v1 + deepseek-flash（现行模型，V4.1-Flash）
#             旧名 deepseek-v4-flash 仍兼容；deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
#   OpenAI：  https://api.openai.com/v1 + gpt-4o-mini
#   其他兼容服务：填对应的 base_url 与模型名
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
MODEL_TIMEOUT=30s
MODEL_MAX_RETRIES=2

# 可选 OTLP/HTTP 导出（例如 http://localhost:4318）。留空时只打结构化日志，
# 不引入 SDK / collector，也没有额外网络请求。
OTLP_ENDPOINT=
